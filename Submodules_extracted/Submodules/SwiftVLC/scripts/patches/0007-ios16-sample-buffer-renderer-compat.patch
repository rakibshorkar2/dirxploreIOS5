+/* AVSampleBufferVideoRenderer was introduced in iOS/tvOS 17. Keep the
+ * AVSampleBufferDisplayLayer compatibility surface for iOS 16 while using the
+ * replacement renderer on newer systems. The legacy methods remain available
+ * through iOS 17 and are only deprecated as of iOS 18. */
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+static BOOL DisplayLayerRequiresFlush(AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (@available(macOS 14.0, iOS 17.0, tvOS 17.0, visionOS 1.0, *))
+        return displayLayer.sampleBufferRenderer.requiresFlushToResumeDecoding;
+    return displayLayer.requiresFlushToResumeDecoding;
+}
+
+static AVQueuedSampleBufferRenderingStatus
+DisplayLayerStatus(AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (@available(macOS 14.0, iOS 17.0, tvOS 17.0, visionOS 1.0, *))
+        return displayLayer.sampleBufferRenderer.status;
+    return displayLayer.status;
+}
+
+static NSError *DisplayLayerError(AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (@available(macOS 14.0, iOS 17.0, tvOS 17.0, visionOS 1.0, *))
+        return displayLayer.sampleBufferRenderer.error;
+    return displayLayer.error;
+}
+
+static void DisplayLayerFlush(AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (@available(macOS 14.0, iOS 17.0, tvOS 17.0, visionOS 1.0, *))
+        [displayLayer.sampleBufferRenderer flush];
+    else
+        [displayLayer flush];
+}
+
+static void DisplayLayerEnqueue(AVSampleBufferDisplayLayer *displayLayer,
+                                CMSampleBufferRef sampleBuffer)
+{
+    if (@available(macOS 14.0, iOS 17.0, tvOS 17.0, visionOS 1.0, *))
+        [displayLayer.sampleBufferRenderer enqueueSampleBuffer:sampleBuffer];
+    else
+        [displayLayer enqueueSampleBuffer:sampleBuffer];
+}
+
+static BOOL DisplayLayerIsReady(AVSampleBufferDisplayLayer *displayLayer)
+{
+    if (@available(macOS 14.0, iOS 17.0, tvOS 17.0, visionOS 1.0, *))
+        return displayLayer.sampleBufferRenderer.isReadyForMoreMediaData;
+    return displayLayer.isReadyForMoreMediaData;
+}
+#pragma clang diagnostic pop
+
